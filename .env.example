# Copy this file to .env and fill in your own values.
# REVFUND_SECRET_KEY: if unset, a random key is generated and persisted in the
#   system_secret table on first boot (so sessions survive restarts).
REVFUND_SECRET_KEY=

# Session idle timeout in seconds (default: 900 = 15 minutes).
SESSION_IDLE_TIMEOUT_SECONDS=900

# Database connection string. If unset, a local SQLite file is used at
# instance/revfund.db. On PythonAnywhere, use their MySQL, e.g.:
# REVFUND_DB_URI=mysql+pymysql://USER:PASSWORD@USER.mysql.pythonanywhere-services.com/USER$default
REVFUND_DB_URI=